    "compromise": "^14.17.0",
    "express": "^5.2.1",
    "jszip": "^3.10.2",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
