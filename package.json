  "description": "Detects and redacts PII in .docx documents, replacing it with consistent fake values.",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "dev": "ts-node src/server/index.ts",
    "redact": "ts-node src/cli/redact.ts",
    "evaluate": "ts-node eval/evaluate.ts",
    "test": "ts-node eval/evaluate.ts"
  },
  "keywords": [
    "pii",
